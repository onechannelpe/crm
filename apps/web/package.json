{
  "name": "@crm/web",
  "type": "module",
  "scripts": {
    "dev": "bun run wait:db && bun run migrate && bun run seed && bun run dev:server",
    "wait:db": "until mise x postgres -- pg_isready -h localhost -p 5432 -q; do echo 'waiting for postgres...'; sleep 0.3; done",
    "dev:server": "bun --env-file=../../.env --bun vite --config vite.config.ts",
    "build": "bun --env-file=../../.env.production --bun vite build --config vite.config.ts",
    "build:container": "bun --bun vite build --config vite.config.ts",
    "start": "bun run .output/server/index.mjs",
    "worker:maintenance": "bun --env-file=../../.env src/workers/maintenance-runner.ts",
    "worker:maintenance:prod": "bun src/workers/maintenance-runner.ts",
    "lint": "oxlint -c .oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src tests",
    "check:types": "bun x tsc --noEmit",
    "check": "bun run check:types && bun run lint",
    "test": "bun --bun --env-file=../../.env.test vitest run --project unit --project contract --project integration --project journey",
    "test:unit": "bun --bun --env-file=../../.env.test vitest run --project unit",
    "test:contract": "bun --bun --env-file=../../.env.test vitest run --project contract",
    "test:integration": "bun --bun --env-file=../../.env.test vitest run --project integration",
    "test:journey": "bun --bun --env-file=../../.env.test vitest run --project journey",
    "test:e2e": "bun --bun --env-file=../../.env.test playwright test",
    "test:e2e:headed": "bun --bun --env-file=../../.env.test playwright test --headed",
    "test:e2e:ui": "bun --bun --env-file=../../.env.test playwright test --ui",
    "test:perf": "bun --env-file=../../.env.test vitest bench --run --config vitest.bench.config.ts",
    "migrate": "bun --env-file=../../.env src/lib/db/migrate-cli.ts",
    "migrate:test": "bun --env-file=../../.env.test src/lib/db/migrate-cli.ts",
    "migrate:prod": "bun src/lib/db/migrate-cli.ts",
    "seed": "bun --env-file=../../.env src/lib/db/seed.ts",
    "seed:test": "bun --env-file=../../.env.test src/lib/db/seed.ts",
    "provision:prod": "bun src/lib/db/seed.ts"
  },
  "dependencies": {
    "@crm/contracts": "workspace:*",
    "@crm/email-composer": "workspace:*",
    "@crm/images": "workspace:*",
    "@crm/message-channels": "workspace:*",
    "@crm/solid-motion": "workspace:*",
    "@fontsource-variable/fraunces": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@fontsource/aleo": "^5.2.7",
    "@fontsource/host-grotesk": "^5.2.8",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@sentry/bun": "^10.59.0",
    "@sentry/solid": "^10.59.0",
    "@simplewebauthn/server": "^13.3.1",
    "@solid-primitives/keyed": "^1.5.1",
    "@solid-primitives/resize-observer": "^2.1.5",
    "@solidjs/router": "^0.16.1",
    "@solidjs/start": "2.0.0-beta.7",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "crossws": "^0.4.5",
    "h3": "2.0.1-rc.25",
    "kysely": "^0.29.2",
    "pg": "^8.22.0",
    "qrcode": "^1.5.4",
    "seroval": "1.5.4",
    "solid-js": "^1.9.14",
    "solid-mdx": "^0.0.7",
    "srvx": "^0.11.15",
    "three": "^0.184.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.2.0",
    "@mdx-js/rollup": "^3.1.1",
    "@playwright/test": "^1.59.1",
    "@sentry/vite-plugin": "^5.2.0",
    "@types/mdx": "^2.0.13",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.184.1",
    "eslint-plugin-solid": "^0.14.5",
    "nitro": "3.0.260610-beta",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.1.4",
    "vitest": "^4.1.4"
  }
}
