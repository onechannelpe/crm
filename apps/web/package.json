{
  "name": "@crm/web",
  "type": "module",
  "scripts": {
    "dev": "bun run migrate && bun run seed && bun --bun vite --config app.config.ts",
    "build": "node --env-file-if-exists=${WEB_ENV_FILE:-../../.env} ./node_modules/vite/bin/vite.js build --config app.config.ts && node ./scripts/build-node-ops.mjs && node ./scripts/ensure-output-runtime-deps.mjs",
    "build:ops": "node ./scripts/build-node-ops.mjs",
    "start": "node ./scripts/ensure-output-runtime-deps.mjs && node --env-file-if-exists=${WEB_ENV_FILE:-../../.env} .output/server/index.mjs",
    "worker:maintenance": "bun --env-file=../../.env src/workers/maintenance-runner.ts",
    "worker:maintenance:prod": "node --env-file-if-exists=${WEB_ENV_FILE:-../../.env} .output/ops/workers/maintenance-runner.mjs",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src tests",
    "build:notifications": "bun run --filter='@crm/notifications' build:emails",
    "check": "bun x tsc --noEmit && bun run lint",
    "test": "bun --env-file=../../.env.test vitest run --project default",
    "test:prepare": "bun --env-file=../../.env.test src/lib/db/migrate-cli.ts && bun --env-file=../../.env.test src/lib/db/seed.ts",
    "serve:test": "bun --env-file=../../.env.test --bun vite --config app.config.ts",
    "test:integration:browser": "bun --env-file=../../.env.test playwright test",
    "test:integration:browser:headed": "bun --env-file=../../.env.test playwright test --headed",
    "test:perf": "bun --env-file=../../.env.test vitest bench --config vitest.bench.config.ts",
    "migrate": "bun --env-file=../../.env src/lib/db/migrate-cli.ts",
    "migrate:prod": "node --env-file-if-exists=${WEB_ENV_FILE:-../../.env} .output/ops/lib/db/migrate-cli.mjs",
    "seed": "bun --env-file=../../.env src/lib/db/seed.ts",
    "seed:prod": "node --env-file-if-exists=${WEB_ENV_FILE:-../../.env} .output/ops/lib/db/seed.mjs"
  },
  "dependencies": {
    "@crm/notifications": "workspace:*",
    "@libsql/client": "^0.17.0",
    "@mdx-js/rollup": "^3.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@simplewebauthn/server": "^13.3.0",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "2.0.0-alpha.2",
    "@solidjs/vite-plugin-nitro-2": "^0.2.0",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "kysely": "^0.28.11",
    "kysely-turso": "0.1.1",
    "qrcode": "^1.5.4",
    "remark-frontmatter": "^5.0.0",
    "solid-js": "^1.9.11",
    "solid-mdx": "^0.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.2.0",
    "@playwright/test": "^1.58.2",
    "@types/mdx": "^2.0.13",
    "@types/mjml": "^4.7.4",
    "@types/qrcode": "^1.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
