{
  "name": "@crm/web",
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite --config app.config.ts",
    "build": "bun --bun vite build --config app.config.ts",
    "start": "bun --bun vite preview --config app.config.ts",
    "worker:sales-export-jobs": "bun --env-file=../../.env src/workers/sales-export-job-runner.ts",
    "worker:sales-export-jobs:once": "bun --env-file=../../.env src/workers/sales-export-job-runner.ts --once",
    "worker:search-enrichment-jobs": "bun --env-file=../../.env src/workers/search-enrichment-job-runner.ts",
    "worker:search-enrichment-jobs:once": "bun --env-file=../../.env src/workers/search-enrichment-job-runner.ts --once",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src tests",
    "build:notifications": "bun run --filter='@crm/notifications' build:emails",
    "prebuild": "bun run build:notifications",
    "precheck": "bun run build:notifications",
    "check": "bun x tsc --noEmit && bun run lint",
    "test": "bun --env-file=../../.env.test vitest run --project default",
    "test:perf": "bun --env-file=../../.env.test vitest bench --config vitest.bench.config.ts",
    "migrate": "bun --env-file=../../.env src/lib/db/migrate-cli.ts",
    "seed": "bun --env-file=../../.env src/lib/db/seed.ts"
  },
  "dependencies": {
    "@crm/notifications": "workspace:*",
    "@libsql/client": "^0.17.0",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@simplewebauthn/server": "^13.2.3",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "2.0.0-alpha.2",
    "clsx": "^2.1.1",
    "kysely": "^0.28.11",
    "kysely-turso": "0.1.1",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.11",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.2.0",
    "@types/mjml": "^4.7.4",
    "@types/qrcode": "^1.5.6",
    "rollup-plugin-visualizer": "^7.0.0",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
