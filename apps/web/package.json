{
  "name": "@crm/web",
  "type": "module",
  "scripts": {
    "dev": "bun run migrate && bun run seed && bun run dev:server",
    "dev:server": "bun --env-file=../../.env --bun vite --config vite.config.ts",
    "build": "bun --env-file=../../.env.production --bun vite build --config vite.config.ts",
    "start": "bun run .output/server/index.mjs",
    "worker:maintenance": "bun --env-file=../../.env src/workers/maintenance-runner.ts",
    "worker:maintenance:prod": "bun src/workers/maintenance-runner.ts",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src tests",
    "check:types": "bun x tsc --noEmit",
    "check": "bun run check:types && bun run lint",
    "test": "bun --bun --env-file=../../.env.test vitest run --project default",
    "test:prepare": "bun run migrate:test && bun run seed:test",
    "test:server": "bun --env-file=../../.env.test --bun vite --config vite.config.ts",
    "test:integration:browser": "playwright test",
    "test:integration:browser:headed": "playwright test --headed",
    "test:perf": "bun --bun --env-file=../../.env.test vitest bench --run --config vitest.bench.config.ts",
    "migrate": "bun --env-file=../../.env src/lib/db/migrate-cli.ts",
    "migrate:test": "bun --env-file=../../.env.test src/lib/db/migrate-cli.ts",
    "migrate:prod": "bun src/lib/db/migrate-cli.ts",
    "seed": "bun --env-file=../../.env src/lib/db/seed.ts",
    "seed:test": "bun --env-file=../../.env.test src/lib/db/seed.ts",
    "seed:prod": "bun src/lib/db/seed.ts"
  },
  "dependencies": {
    "@crm/notifications": "workspace:*",
    "@libsql/client": "^0.17.2",
    "@mdx-js/rollup": "^3.1.1",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@simplewebauthn/server": "^13.3.0",
    "@solidjs/router": "^0.16.1",
    "@solidjs/start": "2.0.0-alpha.2",
    "@solidjs/vite-plugin-nitro-2": "^0.2.0",
    "arctic": "^3.7.0",
    "clsx": "^2.1.1",
    "fast-check": "^4.6.0",
    "kysely": "^0.28.14",
    "kysely-turso": "0.1.1",
    "qrcode": "^1.5.4",
    "remark-frontmatter": "^5.0.0",
    "remark-mdx-frontmatter": "^5.2.0",
    "solid-js": "^1.9.11",
    "solid-mdx": "^0.0.7",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "^5.2.0",
    "@playwright/test": "^1.58.2",
    "@types/mdx": "^2.0.13",
    "@types/mjml": "^4.7.4",
    "@types/qrcode": "^1.5.6",
    "rollup-plugin-visualizer": "^7.0.1",
    "vite": "^7.3.1",
    "vitest": "^4.0.18"
  }
}
