{
  "name": "@crm/web",
  "type": "module",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "worker:inventory-locks": "bun --env-file=../../.env src/workers/inventory-lock-cleaner.ts",
    "worker:inventory-locks:once": "bun --env-file=../../.env src/workers/inventory-lock-cleaner.ts --once",
    "lint": "oxlint -c ../../.oxlintrc.json --type-aware --tsconfig tsconfig.json --deny-warnings src tests",
    "check": "bun x tsc --noEmit && bun run lint",
    "test": "bun --env-file=../../.env vitest run --project default",
    "test:perf": "bun --env-file=../../.env vitest run --project perf",
    "migrate": "bun --env-file=../../.env src/lib/db/migrate-cli.ts",
    "seed": "bun --env-file=../../.env src/lib/db/seed.ts"
  },
  "dependencies": {
    "@crm/notifications": "workspace:*",
    "@libsql/client": "^0.8.0",
    "@libsql/kysely-libsql": "^0.4.1",
    "@node-rs/argon2": "^2.0.2",
    "@oslojs/crypto": "^1.0.1",
    "@oslojs/encoding": "^1.1.0",
    "@oslojs/otp": "^1.1.0",
    "@simplewebauthn/server": "^13.2.2",
    "@solidjs/router": "^0.15.4",
    "@solidjs/start": "1.2.1",
    "clsx": "^2.1.1",
    "kysely": "^0.28.11",
    "qrcode": "^1.5.4",
    "solid-js": "^1.9.11",
    "tailwind-merge": "^3.4.0",
    "vinxi": "^0.5.11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@types/mjml": "^4.7.4",
    "@types/qrcode": "^1.5.6",
    "tailwindcss": "^4.1.18",
    "vitest": "^4.0.18"
  }
}
