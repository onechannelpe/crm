{
  "$schema": "https://schema.fallow.tools/.fallowrc.json",
  "entry": [
    "src/app.tsx",
    "src/entry-client.tsx",
    "src/entry-server.tsx",
    "src/middleware.ts",
    "src/workers/maintenance-runner.ts",
    "src/routes/**/*.{ts,tsx}",
    "src/actions/**/*.{ts,tsx}",
    "vite.config.ts",
    "tracer.ts",
    "vitest.bench.config.ts"
  ],
  "ignorePatterns": [
    "**/*.generated.ts",
    "**/*.generated.tsx",
    "public/**",
    ".output/**",
    "stats.html",
    "content/**"
  ],
  "ignoreUnresolvedImports": [
    "~/*",
    "@tests/*",
    "virtual:*",
    "@solidjs/start/*"
  ],
  "ignoreDependencies": [
    "@crm/contracts",
    "@crm/email-composer",
    "@crm/message-channels",
    "solid-mdx"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "contracts",
        "patterns": ["src/contracts/**"]
      },
      {
        "name": "shared",
        "patterns": ["src/shared/**"]
      },
      {
        "name": "domain",
        "patterns": ["src/domain/**"]
      },
      {
        "name": "browser",
        "patterns": ["src/browser/**"]
      },
      {
        "name": "server",
        "patterns": ["src/server/**"]
      },
      {
        "name": "actions",
        "patterns": ["src/actions/**"]
      },
      {
        "name": "features",
        "patterns": ["src/features/**"]
      },
      {
        "name": "components",
        "patterns": ["src/components/**"]
      },
      {
        "name": "routes",
        "patterns": ["src/routes/**"]
      }
    ],
    "rules": [
      {
        "from": "contracts",
        "allow": ["contracts", "domain", "shared"]
      },
      {
        "from": "shared",
        "allow": ["shared"]
      },
      {
        "from": "domain",
        "allow": ["domain", "shared"]
      },
      {
        "from": "browser",
        "allow": ["browser", "contracts", "domain", "shared"]
      },
      {
        "from": "server",
        "allow": ["contracts", "domain", "server", "shared"]
      },
      {
        "from": "actions",
        "allow": ["actions", "contracts", "domain", "server", "shared"]
      },
      {
        "from": "features",
        "allow": [
          "actions",
          "browser",
          "components",
          "contracts",
          "domain",
          "features",
          "shared"
        ]
      },
      {
        "from": "components",
        "allow": [
          "actions",
          "browser",
          "components",
          "contracts",
          "domain",
          "features",
          "shared"
        ]
      },
      {
        "from": "routes",
        "allow": [
          "actions",
          "browser",
          "components",
          "contracts",
          "domain",
          "features",
          "routes",
          "server",
          "shared"
        ]
      }
    ]
  },
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn"
  }
}
