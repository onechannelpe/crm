{
  "$schema": "https://schema.fallow.tools/.fallowrc.json",
  "entry": [
    "src/app.tsx",
    "src/entry-client.tsx",
    "src/entry-server.tsx",
    "src/middleware.ts",
    "src/workers/maintenance-runner.ts",
    "src/routes/**/*.{ts,tsx}",
    "src/actions/**/*.{ts,tsx}",
    "vite.config.ts",
    "tracer.ts",
    "vitest.bench.config.ts"
  ],
  "ignorePatterns": [
    "**/*.generated.ts",
    "**/*.generated.tsx",
    "public/**",
    ".output/**",
    "stats.html",
    "content/**"
  ],
  "ignoreUnresolvedImports": [
    "~/*",
    "@tests/*",
    "virtual:*",
    "@solidjs/start/*"
  ],
  "ignoreDependencies": [
    "@crm/contracts",
    "@crm/email-composer",
    "@crm/message-channels",
    "solid-mdx"
  ],
  "boundaries": {
    "zones": [
      {
        "name": "contracts",
        "patterns": ["src/contracts/**"]
      },
      {
        "name": "lib",
        "patterns": ["src/lib/**"]
      },
      {
        "name": "server",
        "patterns": ["src/server/**"]
      },
      {
        "name": "actions",
        "patterns": ["src/actions/**"]
      },
      {
        "name": "features",
        "patterns": ["src/features/**"]
      },
      {
        "name": "components",
        "patterns": ["src/components/**"]
      },
      {
        "name": "routes",
        "patterns": ["src/routes/**"]
      }
    ],
    "rules": [
      {
        "from": "contracts",
        "allow": ["contracts", "lib"]
      },
      {
        "from": "server",
        "allow": ["contracts", "lib", "server"]
      },
      {
        "from": "actions",
        "allow": ["actions", "contracts", "lib", "server"]
      },
      {
        "from": "features",
        "allow": ["actions", "components", "contracts", "features", "lib"]
      },
      {
        "from": "components",
        "allow": ["actions", "components", "contracts", "features", "lib"]
      },
      {
        "from": "routes",
        "allow": [
          "actions",
          "components",
          "contracts",
          "features",
          "lib",
          "routes",
          "server"
        ]
      }
    ]
  },
  "rules": {
    "unused-files": "warn",
    "unused-exports": "warn",
    "unused-types": "warn"
  }
}
