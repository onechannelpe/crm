# These values must be unique for every branch deployment.
DEPLOYMENT_NAME=master
APP_DOMAIN=crm.example.com
APP_DATA_PATH=/srv/crm/master

NODE_ENV=production
APP_PUBLIC_ORIGIN=https://crm.example.com
TRUSTED_PROXY=true
SESSION_SECRET=replace-with-at-least-32-random-characters
TOTP_ENCRYPTION_KEY=replace-with-at-least-32-random-characters
SEED_PASSWORD=replace-with-a-bootstrap-password

ENGINE_HMAC_KEY_ID=master
ENGINE_HMAC_SECRET=replace-with-the-matching-engine-secret
ENGINE_TIMEOUT_MS=5000

WEBAUTHN_RP_ID=crm.example.com
WEBAUTHN_ORIGIN=https://crm.example.com

GOOGLE_CLIENT_ID=replace-me
GOOGLE_CLIENT_SECRET=replace-me
GOOGLE_REDIRECT_URI=https://crm.example.com/api/auth/google/callback

NOTIFICATION_ROUTES=email:resend,whatsapp:kapso
RESEND_API_KEY=replace-me
EMAIL_FROM=replace-me
KAPSO_API_KEY=replace-me
KAPSO_WHATSAPP_PHONE_NUMBER_ID=replace-me
KAPSO_META_GRAPH_VERSION=v24.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=replace-with-at-least-32-random-characters
KAPSO_WEBHOOK_SECRET=replace-me

EXTENSION_HANDOFF_PRIVATE_KEY_PKCS8_BASE64=
EXTENSION_HANDOFF_PUBLIC_KEY_SPKI_BASE64=
VITE_SENTRY_DSN=
