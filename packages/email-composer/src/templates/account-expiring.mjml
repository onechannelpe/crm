<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#333333" font-size="14px" line-height="1.6" padding="0" />
    </mj-attributes>
    <mj-style>
      a {
        color: #333333;
      }
    </mj-style>
  </mj-head>
  <mj-body background-color="#f7f7f7">
    <!-- spacer -->
    <mj-section padding="32px 0 0 0" background-color="#f7f7f7">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <!-- card -->
    <mj-section
      background-color="#ffffff"
      border="1px solid #e8e8e8"
      border-radius="8px"
      padding="40px 48px"
    >
      <mj-column>
        <!-- Heading -->
        <mj-text
          font-size="20px"
          font-weight="600"
          color="#333333"
          padding-bottom="24px"
        >
          Tu cuenta vence pronto
        </mj-text>

        <mj-text padding-bottom="8px">Hola {{ fullName }},</mj-text>
        <mj-text padding-bottom="24px">
          Tu cuenta en One Channel vencerá el <strong>{{ expiresAt }}</strong
          >. Pasada esa fecha perderás el acceso. Si crees que esto es un error,
          comunícate con tu administrador.
        </mj-text>

        <mj-text color="#666666" font-size="13px" padding-bottom="0">
          Tu usuario es <strong>{{ username }}</strong
          >.
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="32px 0" background-color="#f7f7f7">
      <mj-column>
        <mj-text align="center" color="#999999" font-size="12px">
          Si no esperabas este correo, contacta a tu administrador.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
