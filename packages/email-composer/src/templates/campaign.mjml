<mjml>
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Inter, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-text color="#333333" font-size="14px" line-height="1.6" padding="0" />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f7f7f7">
    <mj-section padding="32px 0 0 0" background-color="#f7f7f7">
      <mj-column><mj-text> </mj-text></mj-column>
    </mj-section>

    <!-- card -->
    <mj-section
      background-color="#ffffff"
      border="1px solid #e8e8e8"
      border-radius="8px"
      padding="40px 48px"
    >
      <mj-column>
        <!-- crm:multiline:bodyText -->
        <!-- crm:if:title -->
        <mj-text
          font-size="18px"
          font-weight="600"
          color="#333333"
          padding-bottom="20px"
          >{{ title }}</mj-text>
        <!-- crm:endif -->

        <mj-text color="#333333" padding-bottom="0">{{ bodyText }}</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding="32px 0" background-color="#f7f7f7">
      <mj-column>
        <mj-text align="center" color="#999999" font-size="12px">
          Recibiste este mensaje porque tienes una cuenta activa en {{ platformName }}. Si
          crees que fue un error, contacta al administrador.
        </mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
