## Secrets
# Generate with `openssl rand -base64 32`.
SESSION_SECRET=
# Generate separately with `openssl rand -base64 32`.
TOTP_ENCRYPTION_KEY=
# Identifies this web application's key in ENGINE_HMAC_KEYS_JSON.
ENGINE_HMAC_KEY_ID=web
# Generate with `openssl rand -hex 32`.
ENGINE_HMAC_SECRET=
# Map ENGINE_HMAC_KEY_ID to the same value as ENGINE_HMAC_SECRET.
ENGINE_HMAC_KEYS_JSON='{"web":"replace-with-hex-secret"}'

## Web

NODE_ENV=development
SEED_PASSWORD=
TRUSTED_PROXY=false
APP_PUBLIC_ORIGIN=http://localhost:3000
WEB_UPLOADS_ROOT=.local-storage/documents
# WEB_DB_PATH=crm.db

## Engine

ENGINE_HOST=127.0.0.1
ENGINE_PORT=3001
ENGINE_CONNECT_MODE=local
ENGINE_URL=http://127.0.0.1:3001
ENGINE_TIMEOUT_MS=5000
ENGINE_CONTACTS_DB_PATH=crates/engine/data/contacts.sqlite
ENGINE_LEADS_DB_PATH=crates/engine/data/leads.sqlite
ENGINE_RATE_LIMIT_PER_KEY=600
# ENGINE_MAX_LIMIT=100
# ENGINE_HMAC_MAX_SKEW_SECS=60

## Extension

# Extension handoff tokens use one Ed25519 key pair per environment.
# The private key signs tokens. The public key verifies tokens.
#   openssl genpkey -algorithm Ed25519 -out extension-handoff-private.pem
# Private signing key, base64 of PKCS#8 DER:
#   openssl pkcs8 -topk8 -nocrypt -in extension-handoff-private.pem -outform DER | base64 -w0
# Public verification key, base64 of SPKI DER from the same key pair:
#   openssl pkey -in extension-handoff-private.pem -pubout -outform DER | base64 -w0
# Keep the private key secret. Delete the PEM file after storing the key securely.
EXTENSION_EXPECTED_ORIGIN=http://localhost:3000
EXTENSION_HANDOFF_PRIVATE_KEY_PKCS8_BASE64=
EXTENSION_HANDOFF_PUBLIC_KEY_SPKI_BASE64=

## Integrations

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

## Notifications
# Route external channels to concrete providers. Omit a channel to disable it.
NOTIFICATION_ROUTES=email:resend,whatsapp:kapso
RESEND_API_KEY=
EMAIL_FROM=

## WhatsApp (Kapso)
KAPSO_API_KEY=
# Kapso WhatsApp number ID from `kapso whatsapp numbers list`.
KAPSO_WHATSAPP_PHONE_NUMBER_ID=
# Optional: Kapso Meta proxy Graph API version. The application defaults to v24.0.
# KAPSO_META_GRAPH_VERSION=v24.0

## WhatsApp (Meta Cloud direct)
# Unused unless NOTIFICATION_ROUTES includes whatsapp:whatsapp_cloud.
WHATSAPP_CLOUD_ACCESS_TOKEN=
WHATSAPP_CLOUD_PHONE_NUMBER_ID=
# WHATSAPP_CLOUD_GRAPH_VERSION=v24.0

## WhatsApp webhooks
# Required for webhook verification.
# Generate with `openssl rand -base64 32`, then enter the same value in WhatsApp
# Configuration with callback URL https://<public-origin>/api/webhooks/whatsapp.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Required for webhook signature validation.
WHATSAPP_APP_SECRET=

## Observability
