## Secrets

# Run these three commands and paste each output into the matching var:
#   openssl rand -base64 32  ⇢  SESSION_SECRET
#   openssl rand -base64 32  ⇢  TOTP_ENCRYPTION_KEY  (must differ from SESSION_SECRET)
#   openssl rand -hex 32     ⇢  ENGINE_HMAC_SECRET and the secret inside ENGINE_HMAC_KEYS_JSON

SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
ENGINE_HMAC_KEY_ID=web
ENGINE_HMAC_SECRET=
# Supports key rotation. ENGINE_HMAC_KEY_ID must be a key here; its secret must equal ENGINE_HMAC_SECRET.
ENGINE_HMAC_KEYS_JSON='{"web":"replace-with-hex-secret"}'

## Web
NODE_ENV=development
ENGINE_URL=http://localhost:3001

# Must match the domain the browser visits
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# Set true only behind a trusted reverse proxy (Cloudflare)
TRUSTED_PROXY=false

# WEB_DB_PATH=crm.db
WEB_UPLOADS_ROOT=.local-storage/documents

# Set in production. Values are appended to server.allowedHosts.
# __VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=

# LOG_LEVEL=info        # debug | info | warn | error
# LOG_FORMAT=json       # omit for pretty output

## Engine
ENGINE_HOST=127.0.0.1
ENGINE_PORT=3001
ENGINE_DB_PATH=apps/engine/data/contacts.sqlite
ENGINE_RATE_LIMIT_PER_KEY=600
# ENGINE_MAX_LIMIT=100
# ENGINE_HMAC_MAX_SKEW_SECS=60

## Integrations
RESEND_API_KEY=
EMAIL_FROM=

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
