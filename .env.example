# Required
SESSION_SECRET= # openssl rand -base64 32
TOTP_ENCRYPTION_KEY= # openssl rand -base64 32 (must differ from SESSION_SECRET)
ENGINE_HMAC_KEY_ID=web
ENGINE_HMAC_SECRET= # openssl rand -hex 32
# JSON keyring consumed by apps/engine. Must include ENGINE_HMAC_KEY_ID.
ENGINE_HMAC_KEYS_JSON={"web":"replace-with-hex-secret"}

# Web (apps/web/src/lib/env.ts)
NODE_ENV=development
ENGINE_URL=http://localhost:3001
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000
# Set to true only when deployed behind a trusted reverse proxy (Cloudflare, nginx, etc.)
# that overwrites CF-Connecting-IP / X-Forwarded-For. Defaults to false.
TRUSTED_PROXY=false
# Optional
# WEB_DB_PATH is optional.
# If omitted, apps/web defaults to `crm.db` in its own working directory.
# When setting it, use a path relative to `apps/web` (for example: `crm.db`),
# not `apps/web/...`, to avoid resolving to `apps/web/apps/web/...`.
# WEB_DB_PATH=crm.db
# Uploads root (default: .local-storage/documents)
WEB_UPLOADS_ROOT=.local-storage/documents
# On production: set this to our domain
__VITE_ADDITIONAL_SERVER_ALLOWED_HOSTS=

# Engine (apps/engine/src/config/mod.rs)
ENGINE_HOST=127.0.0.1
ENGINE_PORT=3001
ENGINE_DB_PATH=apps/engine/data/contacts.sqlite
ENGINE_RATE_LIMIT_PER_KEY=600

# Integrations (apps/web/src/lib/env.ts)
RESEND_API_KEY=
EMAIL_FROM=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
