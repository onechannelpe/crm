## Secrets
# openssl rand -base64 32 for SESSION_SECRET and TOTP_ENCRYPTION_KEY (must differ)
# openssl rand -hex 32 for ENGINE_HMAC_SECRET; paste the same value in ENGINE_HMAC_KEYS_JSON

SESSION_SECRET=
TOTP_ENCRYPTION_KEY=
ENGINE_HMAC_KEY_ID=web
ENGINE_HMAC_SECRET=
ENGINE_HMAC_KEYS_JSON='{"web":"replace-with-hex-secret"}'

## Web

NODE_ENV=development
SEED_PASSWORD=
TRUSTED_PROXY=false
WEB_UPLOADS_ROOT=.local-storage/documents
# WEB_DB_PATH=crm.db

## Engine

ENGINE_HOST=127.0.0.1
ENGINE_PORT=3001
ENGINE_CONNECT_MODE=local
ENGINE_URL=http://127.0.0.1:3001
ENGINE_TIMEOUT_MS=5000
ENGINE_CONTACTS_DB_PATH=crates/engine/data/contacts.sqlite
ENGINE_LEADS_DB_PATH=crates/engine/data/leads.sqlite
ENGINE_RATE_LIMIT_PER_KEY=600
# ENGINE_MAX_LIMIT=100
# ENGINE_HMAC_MAX_SKEW_SECS=60

## Extension

# Extension handoff tokens use one Ed25519 key pair per environment.
# The private key signs tokens. The public key verifies tokens.
#   openssl genpkey -algorithm Ed25519 -out extension-handoff-private.pem
# Private signing key, base64 of PKCS#8 DER:
#   openssl pkcs8 -topk8 -nocrypt -in extension-handoff-private.pem -outform DER | base64 -w0
# Public verification key, base64 of SPKI DER from the same key pair:
#   openssl pkey -in extension-handoff-private.pem -pubout -outform DER | base64 -w0
# Keep the private key secret. Delete the PEM file after storing the key securely.
EXTENSION_EXPECTED_ORIGIN=http://localhost:3000
EXTENSION_HANDOFF_PRIVATE_KEY_PKCS8_BASE64=
EXTENSION_HANDOFF_PUBLIC_KEY_SPKI_BASE64=

## Integrations

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
RESEND_API_KEY=
EMAIL_FROM=

## WhatsApp (Meta Cloud API)
# Required integration. The app fails to boot if any non-defaulted var is unset.
#
# From Meta App Dashboard > WhatsApp > API Setup:
#   WHATSAPP_ACCESS_TOKEN     System user / permanent access token used to send.
#   WHATSAPP_PHONE_NUMBER_ID  The "Phone number ID" of the sending number.
# From Meta App Dashboard > App Settings > Basic:
#   WHATSAPP_APP_SECRET       "App secret"; verifies the X-Hub-Signature-256
#                             header on incoming webhook POSTs.
# Operator-chosen, set this same value in the Meta webhook config:
#   WHATSAPP_WEBHOOK_VERIFY_TOKEN  Echoed on GET registration. Generate a strong
#                                  one (>=32 chars, entropy-checked at boot):
#                                    openssl rand -base64 32
# Optional, defaults to v23.0:
#   WHATSAPP_GRAPH_API_VERSION
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# WHATSAPP_GRAPH_API_VERSION=v23.0

