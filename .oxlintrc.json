{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "vitest",
    "jsx-a11y"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    ".vinxi/**",
    ".output/**",
    "coverage/**",
    "app.config.timestamp_*.js"
  ]
}
