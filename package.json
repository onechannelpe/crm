{
  "name": "one-workspace",
  "private": true,
  "packageManager": "bun@1.3.10",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --parallel dev:engine dev:web",
    "dev:engine": "cargo run -p crm-engine",
    "dev:web": "bun --no-env-file --env-file=../../.env run --cwd apps/web dev",
    "dev:worker": "bun --no-env-file --env-file=../../.env run --cwd apps/web worker:maintenance",
    "pipeline:engine": "cargo run -p crm-pipeline --",
    "pipeline:refresh": "bun run pipeline:engine refresh --slice 100k",
    "pipeline:refresh:10k": "bun run pipeline:engine refresh --slice 10k",
    "pipeline:refresh:100k": "bun run pipeline:engine refresh --slice 100k",
    "pipeline:verify-manifest": "bun run pipeline:engine verify-manifest",
    "pipeline:normalize-sample": "bun run pipeline:engine validate --profile quick",
    "test:engine": "cargo test -p crm-engine",
    "generate": "bun run --parallel generate:engine-contract generate:search-projection-contract generate:templates",
    "generate:templates": "bun run --cwd packages/notifications build:emails",
    "check:rust": "cargo xtask-check && cargo xtask-fmt && cargo xtask-clippy",
    "check": "bun run generate:templates && bun run check:rust && bun run --parallel check:contract check:projection-contract check:search-contract check:web check:format:ts",
    "check:contract": "bun run scripts/generate-engine-contract.ts --check",
    "check:web": "bun run --cwd apps/web check",
    "check:engine": "cargo xtask-check",
    "check:lint": "bun run --parallel check:lint:web check:lint:packages",
    "check:lint:web": "oxlint -c .oxlintrc.json --type-aware --tsconfig apps/web/tsconfig.json --deny-warnings apps/web/src apps/web/tests",
    "check:lint:packages": "oxlint -c .oxlintrc.json --deny-warnings packages scripts",
    "check:format": "bun run --parallel check:format:ts check:format:rust",
    "check:format:ts": "oxfmt --check apps/web packages scripts",
    "check:format:rust": "cargo xtask-fmt",
    "check:clippy": "cargo xtask-clippy",
    "format": "bun run --parallel format:ts format:rust",
    "format:ts": "oxfmt apps/web packages scripts",
    "format:rust": "cargo xtask-format",
    "clean": "shx rm -rf apps/web/*.db* 'apps/*/node_modules' node_modules",
    "generate:engine-contract": "bun run scripts/generate-engine-contract.ts",
    "generate:search-projection-contract": "bun run scripts/generate-search-projection-contract.ts",
    "refs:fetch": "bun run --cwd packages/fetch-refs fetch",
    "check:search-contract": "bun run scripts/check-search-contract.ts",
    "check:projection-contract": "bun run scripts/generate-search-projection-contract.ts --check",
    "test:extension:integration": "bun run --cwd apps/extension test:integration"
  },
  "devDependencies": {
    "@types/bun": "^1.3.10",
    "@types/node": "^25.4.0",
    "oxfmt": "^0.38.0",
    "oxlint": "^1.53.0",
    "oxlint-tsgolint": "^0.16.0",
    "shx": "^0.4.0"
  }
}
