{
  "name": "one-workspace",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check:web": "bun run --cwd apps/web check",
    "check:engine": "cargo check --manifest-path apps/engine/Cargo.toml",
    "check:engine-contract": "bun run scripts/generate-engine-contract.ts --check",
    "check": "bun run check:engine-contract && bun run check:web && bun run check:engine && bun run format:check",
    "generate:engine-contract": "bun run scripts/generate-engine-contract.ts",
    "format": "oxfmt apps/web packages scripts",
    "format:check": "oxfmt --check apps/web packages scripts"
  },
  "devDependencies": {
    "oxfmt": "^0.33.0"
  }
}