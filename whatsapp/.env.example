# ─────────────────────────────────────────────────────────────
#  CRM → WhatsApp notifier (OpenWA)
#  Copia este archivo a .env y ajusta los valores.
# ─────────────────────────────────────────────────────────────

# Base de datos del CRM (servidor libsql / sqld).
# Es la misma URL que usa la web (WEB_DB_URL). Por defecto sqld escucha aquí.
WEB_DB_URL=http://127.0.0.1:8080
# Token de auth de libsql (solo si tu sqld lo requiere; en local suele ir vacío).
WEB_DB_AUTH_TOKEN=

# Gateway OpenWA
OPENWA_BASE_URL=http://localhost:2785
OPENWA_API_KEY=REEMPLAZA_CON_TU_API_KEY
# Nombre de la sesión de WhatsApp en OpenWA (no el UUID).
# El notifier resuelve el UUID automáticamente a partir del nombre.
OPENWA_SESSION_NAME=pruebita

# Cada cuánto revisa nuevas notificaciones (ms).
POLL_INTERVAL_MS=4000

# Solo se reenvían notificaciones de usuarios con este rol.
TARGET_ROLE=executive

# Prefijo de país que se antepone a números locales de 9 dígitos (Perú = 51).
COUNTRY_CODE=51

# De dónde empezar la PRIMERA vez (sin estado previo):
#   now        = ignora el historial, solo reenvía notificaciones nuevas (recomendado)
#   beginning  = reenvía TODO el historial pendiente (cuidado: puede ser mucho)
START_FROM=now

# Opcional: si lo defines, se añade un enlace al final del mensaje usando action_url.
# Ej: https://crm.tudominio.com  ->  el mensaje incluirá https://crm.tudominio.com/records/123
CRM_BASE_URL=

# Modo simulación: si es "true", NO envía a WhatsApp, solo imprime lo que enviaría.
DRY_RUN=false

# ─── Anti-baneo (ritmo humano de envío) ───────────────────────────────────
# WhatsApp banea números que envían en ráfaga. Estos parámetros espacian los
# mensajes de forma aleatoria y limitan el volumen.
#
# Espera ALEATORIA entre un mensaje y el siguiente, en segundos. El valor real
# se sortea uniformemente entre MIN y MAX en cada envío (impredecible = humano).
MIN_DELAY_SEC=45
MAX_DELAY_SEC=150
# Topes de volumen (frena aunque haya cola).
MAX_PER_HOUR=15
MAX_PER_DAY=120
# Mostrar "escribiendo…" unos segundos antes de enviar (0 = desactivar).
TYPING_SEC=3
# Horario silencioso: rango en que NO se envía (los bots envían 24/7; un humano
# no). Formato "HH:MM-HH:MM" (admite cruzar medianoche). Vacío = sin restricción.
QUIET_HOURS=22:00-07:00
# Verificar con WhatsApp que el número exista antes de enviar. Recomendado:
# enviar a números inexistentes/que no usan WhatsApp es una señal de spam.
VERIFY_NUMBER=true
